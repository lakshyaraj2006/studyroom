<mjml>
  <mj-head>
    <mj-title>New Contact Message - StudyRoom</mj-title>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" />
      <mj-text font-size="14px" color="#374151" line-height="1.5" />
    </mj-attributes>
    <mj-style>
      .message-box {
        background-color: #f9fafb;
        border-left: 4px solid #4f46e5;
        padding: 16px;
        border-radius: 4px;
        font-family: inherit;
        white-space: pre-wrap;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <!-- Header -->
    <mj-section background-color="#4f46e5" padding="24px">
      <mj-column>
        <mj-text font-size="24px" font-weight="700" color="#ffffff" align="center">
          StudyRoom Support
        </mj-text>
        <mj-text font-size="14px" color="#c7d2fe" align="center" padding-top="4px">
          New Contact Submission
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Content -->
    <mj-section background-color="#ffffff" padding="32px 24px">
      <mj-column>
        <mj-text font-size="18px" font-weight="600" color="#111827">
          Hello Admin,
        </mj-text>
        <mj-text>
          A user has submitted a message via the StudyRoom contact form. Here are the submission details:
        </mj-text>

        <!-- Sender Info Table -->
        <mj-table padding-top="16px" padding-bottom="16px">
          <tr style="border-bottom: 1px solid #e5e7eb; text-align: left;">
            <th style="padding: 10px 0; color: #4b5563; font-weight: 600; width: 100px;">Sender</th>
            <td style="padding: 10px 0; color: #111827;">{{name}}</td>
          </tr>
          <tr style="border-bottom: 1px solid #e5e7eb; text-align: left;">
            <th style="padding: 10px 0; color: #4b5563; font-weight: 600;">Email</th>
            <td style="padding: 10px 0; color: #4f46e5; font-weight: 500;">
              <a href="mailto:{{email}}" style="color: #4f46e5; text-decoration: none;">{{email}}</a>
            </td>
          </tr>
          <tr style="border-bottom: 1px solid #e5e7eb; text-align: left;">
            <th style="padding: 10px 0; color: #4b5563; font-weight: 600;">Subject</th>
            <td style="padding: 10px 0; color: #111827;">{{subject}}</td>
          </tr>
        </mj-table>

        <mj-text font-weight="600" color="#111827" padding-top="8px">
          Message Content:
        </mj-text>
        
        <mj-text>
          <div class="message-box">
            {{message}}
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f9fafb" padding="16px">
      <mj-column>
        <mj-text font-size="12px" color="#9ca3af" align="center">
          This is an automated notification from StudyRoom. You can reply directly to this email to contact the sender.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
