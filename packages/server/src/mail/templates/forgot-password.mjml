<mjml>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="24px">
      <mj-column>
        <mj-text font-size="18px" font-family="Poppins, Arial">
          Hello, {{username}}
        </mj-text>

        <mj-text>
          We have made it easy for you to reset your forgotten password.
        </mj-text>

        <mj-text>
          Ignore this email if it was not you.
        </mj-text>

        <mj-text font-size="20px" font-weight="bold">
          Code: {{code}}
        </mj-text>

        <mj-text>
          The code will expire after 8 hours.
        </mj-text>

        <mj-text color="red">
          Please do not share your code with anyone else.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
