# If you have database on mongodb atlas, paste the url in the .env file
MONGODB_URI="mongodb://localhost:27017/studyroom"

# Generate secure secrets & store in .env file
ACCESS_TOKEN_SECRET="yoursecret1"

REFRESH_TOKEN_SECRET="yoursecret2"

# Nodemailer Config
NODEMAILER_HOST="your_smtp_host"
NODEMAILER_PORT="your_smtp_port"
NODEMAILER_USER="your_username"
NODEMAILER_PASS="your_password"

# Frontend url
FRONTEND_URL="http://localhost:5173"

# Cloudinary config
CLOUDINARY_CLOUD_NAME="<your_cloud_name>"
CLOUDINARY_CLOUD_API_KEY="<your_api_key>"
CLOUDINARY_CLOUD_API_SECRET="<your_api_secret>"

# Passport Config
GOOGLE_CLIENT_ID="<your_google_client_id>"
GOOGLE_CLIENT_SECRET="<your_google_client_secret>"
